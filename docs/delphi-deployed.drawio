        </mxCell>
        <mxCell id="s1d" parent="s1g" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Invoke&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;delphi-verify --arn calls InvokeAgentRuntime, signed with SigV4. Same API, either arm.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="388" x="52" as="geometry" />
        </mxCell>
        <mxCell id="s2g" connectable="0" parent="legend-container" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="88" width="440" y="92" as="geometry" />
        </mxCell>
        <mxCell id="s2b" parent="s2g" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="2" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="s2d" parent="s2g" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Load artifact&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Cold start: the router reads router/current.json, then loads the immutable router/&amp;lt;hash&amp;gt;/ it names. The bucket is external: referenced by name, never managed by the arm stacks.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="388" x="52" as="geometry" />
        </mxCell>
        <mxCell id="s3g" connectable="0" parent="legend-container" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="88" width="440" y="184" as="geometry" />
        </mxCell>
        <mxCell id="s3b" parent="s3g" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="3" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="s3d" parent="s3g" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Image and rollback&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Both arms run one ARM64 image from ECR. Rollback: image-tag override per stack, exercised on the pinned arm.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="388" x="52" as="geometry" />
        </mxCell>
        <mxCell id="s4g" connectable="0" parent="legend-container" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="88" width="440" y="276" as="geometry" />
        </mxCell>
        <mxCell id="s4b" parent="s4g" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="4" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="s4d" parent="s4g" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Route and invoke&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;The router picks one of 3 models and calls it through Converse. Warm routing overhead P90: 0.3 ms vs a 150 ms budget. The pinned arm always calls nova-lite.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="388" x="52" as="geometry" />
        </mxCell>
        <mxCell id="s5g" connectable="0" parent="legend-container" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="88" width="440" y="368" as="geometry" />
        </mxCell>
        <mxCell id="s5b" parent="s5g" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="5" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="s5d" parent="s5g" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Telemetry&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Decision record v1 to CloudWatch on every invocation, failures included: error_kind, cold_start, routing_overhead_ms, prompt_sha256.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="388" x="52" as="geometry" />
        </mxCell>
        <mxCell id="s6g" connectable="0" parent="legend-container" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="88" width="440" y="460" as="geometry" />
        </mxCell>
        <mxCell id="s6b" parent="s6g" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="6" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="s6d" parent="s6g" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Deploy&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;One CDK stack per arm, cdk-nag AwsSolutions at every synth. Bucket mode is required: existing (live) or create, which adds a retained bucket stack.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="388" x="52" as="geometry" />
        </mxCell>
        <mxCell id="s7g" connectable="0" parent="legend-container" style="group;fontFamily=Helvetica;" value="" vertex="1">
          <mxGeometry height="88" width="440" y="552" as="geometry" />
        </mxCell>
        <mxCell id="s7b" parent="s7g" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;fontFamily=Helvetica;shadow=1;glass=0;strokeWidth=2;" value="7" vertex="1">
          <mxGeometry height="38" width="40" y="2" as="geometry" />
        </mxCell>
        <mxCell id="s7d" parent="s7g" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=13;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Least privilege&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;- &lt;/b&gt;Each arm's role invokes only its own pool. S3 read: router/* on the router arm only.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="88" width="388" x="52" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="legend-container" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontFamily=Helvetica;" value="&lt;div style=&quot;font-size: 13px;&quot;&gt;&lt;i&gt;&lt;b&gt;Live in us-west-2.&lt;/b&gt; Proves the mechanism: route, Converse, telemetry.&lt;/i&gt;&lt;/div&gt;&lt;div style=&quot;font-size: 13px;&quot;&gt;&lt;i&gt;Routing quality is synthetic-trained: no quality verdict. The P90 is warm and in-process over 200 calls: not end to end.&lt;/i&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="86" width="420" y="648" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
